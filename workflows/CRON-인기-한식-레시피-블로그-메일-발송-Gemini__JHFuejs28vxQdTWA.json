      "parameters": {
        "url": "https://news.google.com/rss/search?q=%ED%95%9C%EC%8B%9D+%EB%A0%88%EC%8B%9C%ED%94%BC+%EC%9D%B8%EA%B8%B0+when:30d&hl=ko&gl=KR&ceid=KR:ko",
