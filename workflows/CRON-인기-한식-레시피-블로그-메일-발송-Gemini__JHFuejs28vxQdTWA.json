    {
      "id": "c2000000-0000-4000-8000-000000000010",
      "name": "2-2. 레시피 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "jsCode": "function parseGemini(res) {\n  const parts = res.candidates?.[0]?.content?.parts || [];\n  const text = parts.filter(p => !p.thought).map(p => p.text || '').join('');\n  const m = text.replace(/```json|```/g, '').match(/\\{[\\s\\S]*\\}/);\n  if (!m) throw new Error(text ? 'Gemini 응답에서 JSON을 찾을 수 없습니다: ' + text.slice(0, 300) : 'Gemini 응답이 비어 있습니다: ' + JSON.stringify(res).slice(0, 400));\n  return JSON.parse(m[0]);\n}\n\nconst r = parseGemini($input.first().json);\nif (!r.title || !Array.isArray(r.ingredients) || !Array.isArray(r.steps)) {\n  throw new Error('레시피 필드가 누락되었습니다: ' + JSON.stringify(r).slice(0, 300));\n}\nconst food = $('1-4. 선정 결과 정리').first().json;\nreturn [{ json: { ...r, food_ko: food.food_ko, food_en: food.food_en } }];"
      }
