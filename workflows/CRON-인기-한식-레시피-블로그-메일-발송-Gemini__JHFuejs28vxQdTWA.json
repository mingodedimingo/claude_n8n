    {
      "id": "c2000000-0000-4000-8000-000000000004",
      "name": "1-2. 음식 선정 요청 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "jsCode": "// 최근 30일 뉴스 제목을 근거로 인기 한식 1가지를 고르도록 Gemini 요청 구성\nconst today = $now.setZone('Asia/Seoul');\nconst m = today.month;\nconst season = [12, 1, 2].includes(m) ? '겨울' : [3, 4, 5].includes(m) ? '봄' : [6, 7, 8].includes(m) ? '여름' : '가을';\nconst headlines = $input.all().map(i => i.json.title).filter(Boolean).slice(0, 30);\nconst news = headlines.length\n  ? headlines.map((t, i) => (i + 1) + '. ' + t).join(String.fromCharCode(10))\n  : '(뉴스를 가져오지 못했습니다. 시기와 최근 트렌드를 고려하세요.)';\n\nconst system = [\n  '당신은 한국 음식 트렌드 분석가입니다.',\n  '제공된 최근 30일 한식 관련 뉴스 제목과 현재 시기(' + today.toFormat('yyyy년 M월') + ', ' + season + ')를 근거로,',\n  '최근 한국에서 가장 인기 있고 화제가 된 한식 중 집에서 만들 수 있는 한 끼 요리 1가지를 선정하세요.',\n  '김치·깍두기 같은 반찬 단독 메뉴는 제외하세요.',\n  '반드시 아래 JSON 형식으로만 답하세요.',\n  '{\"food_ko\":\"음식 한글명\",\"food_en\":\"영문명(이미지 검색용, 예: kimchi fried rice)\",\"reason\":\"선정 이유 한 문장\"}'\n].join(String.fromCharCode(10));\nconst user = '오늘은 ' + today.toFormat('yyyy-MM-dd') + '입니다.' + String.fromCharCode(10, 10) + '[최근 30일 한식 관련 뉴스 제목]' + String.fromCharCode(10) + news;\n\nreturn [{ json: { body: {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { temperature: 1.0 }\n} } }];"
      }
    },
