    {
      "id": "c2000000-0000-4000-8000-000000000012",
      "name": "5-1. 블로그 양식 다듬기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "// 이메일용 블로그 HTML 구성\nconst r = $('2-2. 레시피 정리').first().json;\nconst pages = Object.values($input.first().json.query?.pages || {}).sort((a, b) => (a.index || 0) - (b.index || 0));\nconst page = pages.find(p => p.imageinfo?.[0]?.thumburl && /\\.(jpe?g|png)$/i.test(p.title));\nconst imageUrl = page ? page.imageinfo[0].thumburl : '';\nconst sourceUrl = page ? (page.imageinfo[0].descriptionurl || page.imageinfo[0].url) : '';\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst h2 = 'font-size:19px;border-bottom:2px solid #e8590c;padding-bottom:4px;margin-top:28px;';\n\nconst html = `\n<div style=\"max-width:640px;margin:0 auto;font-family:'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:#222;line-height:1.7;\">\n  <h1 style=\"font-size:26px;margin-bottom:4px;\">🍚 ${esc(r.title)}</h1>\n  <p style=\"color:#555;margin-top:0;\"><b>음식 설명</b> : ${esc(r.description)}</p>\n  ${imageUrl ? `<img src=\"${imageUrl}\" alt=\"${esc(r.title)}\" style=\"width:100%;border-radius:12px;\"/>\n  <p style=\"font-size:11px;color:#999;margin-top:4px;\">이미지 출처: <a href=\"${sourceUrl}\">Wikimedia Commons</a></p>` : ''}\n  <p>${esc(r.intro)}</p>\n  <h2 style=\"${h2}\">🛒 재료 (2인분)</h2>\n  <ul>${r.ingredients.map(i => `<li>${esc(i)}</li>`).join('')}</ul>\n  <h2 style=\"${h2}\">👩‍🍳 요리 순서</h2>\n  <ol>${r.steps.map(s => `<li style=\"margin-bottom:8px;\">${esc(s)}</li>`).join('')}</ol>\n  <h2 style=\"${h2}\">💡 전문가 팁</h2>\n  <p>${esc(r.tip)}</p>\n  <p>${esc(r.outro)}</p>\n</div>`;\n\nreturn [{ json: { subject: '[오늘의 한식 레시피] ' + r.title, html, imageUrl, hasImage: !!imageUrl } }];"
      }
    },
