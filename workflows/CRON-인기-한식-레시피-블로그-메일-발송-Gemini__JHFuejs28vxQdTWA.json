    {
      "id": "c2000000-0000-4000-8000-000000000007",
      "name": "1-4. 선정 결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "function parseGemini(res) {\n  const parts = res.candidates?.[0]?.content?.parts || [];\n  const text = parts.filter(p => !p.thought).map(p => p.text || '').join('');\n  const m = text.replace(/```json|```/g, '').match(/\\{[\\s\\S]*\\}/);\n  if (!m) throw new Error(text ? 'Gemini 응답에서 JSON을 찾을 수 없습니다: ' + text.slice(0, 300) : 'Gemini 응답이 비어 있습니다: ' + JSON.stringify(res).slice(0, 400));\n  return JSON.parse(m[0]);\n}\n\nconst food = parseGemini($input.first().json);\nif (!food.food_ko || !food.food_en) throw new Error('음식 선정 결과가 올바르지 않습니다: ' + JSON.stringify(food));\n\n// 2단계: 재료·요리 순서 요약 + 블로그 글 작성 요청 구성\nconst system = [\n  '당신은 30년 경력의 한식 요리 전문가이자 요리 블로거입니다.',\n  '- 한식 전문가다운 확신 있는 말투를 쓰되, 독자에게 친절하게 \"~하세요\" 어조로 안내하세요.',\n  '- 군더더기 없이 간결하게 설명하세요.',\n  '- 재료는 2인분 기준으로 계량(g, 큰술, 컵 등)을 포함하세요.',\n  '- 요리 순서는 5~8단계, 각 단계는 1~2문장으로 쓰세요.',\n  '반드시 아래 JSON 형식으로만 답하세요.',\n  '{',\n  '  \"title\": \"음식 이름 (예: 김치 볶음밥)\",',\n  '  \"description\": \"한 줄 음식 설명 (예: 김치와 햄을 이용, 간단하게 만들 수 있는 인기 음식)\",',\n  '  \"intro\": \"블로그 도입부 2~3문장\",',\n  '  \"ingredients\": [\"재료와 분량\"],',\n  '  \"steps\": [\"요리 순서\"],',\n  '  \"tip\": \"전문가 팁 1~2문장\",',\n  '  \"outro\": \"마무리 인사 1문장\"',\n  '}'\n].join(String.fromCharCode(10));\nconst user = '음식: ' + food.food_ko + String.fromCharCode(10) + '선정 이유: ' + (food.reason || '') + String.fromCharCode(10, 10) + '이 음식의 재료와 요리 순서를 요약하고 블로그 글을 작성해 주세요.';\n\nreturn [{ json: { ...food, body: {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { temperature: 0.7 }\n} } }];"
      }
    },
