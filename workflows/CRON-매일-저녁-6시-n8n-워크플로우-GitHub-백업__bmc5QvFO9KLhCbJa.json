    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "백업 파일 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// origin 주소에서 owner/repo 추출\nconst cfg = $('백업 설정 (origin)').first().json;\nconst m = String(cfg.origin).match(/github[.]com[:/]([^/]+)[/](.+?)(?:[.]git)?[/]?$/);\nif (!m) throw new Error('origin 주소를 해석할 수 없습니다: ' + cfg.origin);\nconst owner = m[1];\nconst repo = m[2];\nconst api = 'https://api.github.com/repos/' + owner + '/' + repo;\n\nconst files = [];\nfor (const item of $input.all()) {\n  const wf = { ...item.json };\n  if (String(wf.name || '').startsWith('[TEMP]')) continue; // 임시 테스트 워크플로우 제외\n  delete wf.staticData; // 실행할 때마다 바뀌는 값은 제외 (불필요한 커밋 방지)\n  const safeName = String(wf.name || 'untitled')\n    .replace(/[^0-9A-Za-z가-힣ㄱ-ㅎㅏ-ㅣ._-]+/g, '-')\n    .replace(/-+/g, '-')\n    .replace(/^-|-$/g, '')\n    .slice(0, 80);\n  files.push({\n    path: cfg.dir + '/' + safeName + '__' + wf.id + '.json',\n    name: wf.name,\n    content: JSON.stringify(wf, null, 2) + String.fromCharCode(10),\n  });\n}\nreturn [{ json: { owner, repo, api, branch: cfg.branch, dir: cfg.dir, files } }];"
      }
    },
