          2400,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const prep = $('백업 파일 준비').first().json;\nconst total = prep.files.length;\nconst stamp = $now.setZone('Asia/Seoul').toFormat('MM/dd HH:mm');\nconst j = $input.first().json;\nlet message;\nif (!Array.isArray(j.files)) {\n  message = '[n8n 백업] ' + stamp + ' 변경 없음 (전체 ' + total + '개)';\n} else {\n  const c = { added: 0, modified: 0, removed: 0 };\n  for (const f of j.files) if (c[f.status] !== undefined) c[f.status]++;\n  message = '[n8n 백업] ' + stamp + ' 전체 ' + total + '개 → 신규 ' + c.added + ', 수정 ' + c.modified + ', 삭제 ' + c.removed + ' (커밋 ' + String(j.sha).slice(0, 7) + ')';\n}\nreturn [{ json: { message: message.slice(0, 190) } }];"
        }
