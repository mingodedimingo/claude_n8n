        "name": "새 트리 구성",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const prep = $('백업 파일 준비').first().json;\nconst parentSha = $('브랜치 최신 커밋 조회').first().json.sha;\nconst oldTree = $input.first().json;\n\nconst tree = prep.files.map((f) => ({ path: f.path, mode: '100644', type: 'blob', content: f.content }));\nconst keep = new Set(prep.files.map((f) => f.path));\n// n8n에서 삭제된 워크플로우 파일은 저장소에서도 제거 (커밋 이력에는 남음)\nfor (const e of oldTree.tree || []) {\n  if (e.type === 'blob' && e.path.startsWith(prep.dir + '/') && e.path.endsWith('.json') && !keep.has(e.path)) {\n    tree.push({ path: e.path, mode: '100644', type: 'blob', sha: null });\n  }\n}\nreturn [{ json: { parentSha, baseTreeSha: oldTree.sha, body: { base_tree: oldTree.sha, tree } } }];"
        }
