    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "결과 요약",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst first = items[0].json;\nconst stamp = $now.setZone('Asia/Seoul').toFormat('MM/dd HH:mm');\nlet message;\nif (first.noChange === true) {\n  message = '[n8n 백업] ' + stamp + ' 변경 없음 (전체 ' + first.total + '개)';\n} else {\n  const prepared = $('변경 여부 판단').all();\n  const total = prepared[0].json.total;\n  const unchanged = prepared[0].json.unchanged;\n  const failed = [];\n  let created = 0, updated = 0;\n  items.forEach((it, i) => {\n    const src = prepared[i] ? prepared[i].json : {};\n    if (it.json.error || !it.json.content) { failed.push(src.workflowName || '?'); return; }\n    if (src.isNew) created++; else updated++;\n  });\n  message = '[n8n 백업] ' + stamp + ' 전체 ' + total + '개: 신규 ' + created + ', 수정 ' + updated + ', 변경없음 ' + unchanged;\n  if (failed.length) message += ' / 실패 ' + failed.length + ': ' + failed.join(', ');\n}\nreturn [{ json: { message: message.slice(0, 190) } }];"
      }
    },
