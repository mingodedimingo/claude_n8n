    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "백업 파일 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 백업 대상 저장소 설정\nconst OWNER = 'mingodedimingo';\nconst REPO = 'claude_n8n';\nconst DIR = 'workflows';\n\nconst out = [];\nfor (const item of $input.all()) {\n  const wf = item.json;\n  const safeName = String(wf.name || 'untitled')\n    .replace(/[^0-9A-Za-z가-힣ㄱ-ㅎㅏ-ㅣ._-]+/g, '-')\n    .replace(/-+/g, '-')\n    .replace(/^-|-$/g, '')\n    .slice(0, 80);\n  const path = DIR + '/' + safeName + '__' + wf.id + '.json';\n  const body = JSON.stringify(wf, null, 2) + String.fromCharCode(10);\n  out.push({\n    json: {\n      workflowId: wf.id,\n      workflowName: wf.name,\n      path,\n      url: 'https://api.github.com/repos/' + OWNER + '/' + REPO + '/contents/' + path.split('/').map(encodeURIComponent).join('/'),\n      contentBase64: Buffer.from(body, 'utf8').toString('base64'),\n    },\n  });\n}\nreturn out;"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "GitHub 기존 파일 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "v9uk3bfNFXDRK5Pk",
          "name": "GitHub (mingodedimingo)"
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "변경 여부 판단",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prepared = $('백업 파일 준비').all();\nconst existing = $input.all();\nconst stamp = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd HH:mm');\nconst clean = (s) => String(s || '').replace(/[^A-Za-z0-9+/=]/g, '');\n\nconst changed = [];\nlet unchanged = 0;\nlet lookupErrors = 0;\nprepared.forEach((p, i) => {\n  const res = existing[i] ? existing[i].json : {};\n  const status = res.statusCode;\n  const body = res.body || {};\n  if (status === 200 && clean(body.content) === clean(p.json.contentBase64)) {\n    unchanged++;\n    return;\n  }\n  if (status !== 200 && status !== 404) lookupErrors++;\n  const payload = {\n    message: 'backup: ' + p.json.workflowName + ' (' + stamp + ')',\n    content: p.json.contentBase64,\n  };\n  if (status === 200 && body.sha) payload.sha = body.sha;\n  changed.push({ json: { ...p.json, isNew: status !== 200, payload } });\n});\n\nconst total = prepared.length;\nif (changed.length === 0) {\n  return [{ json: { noChange: true, total, unchanged, lookupErrors } }];\n}\nreturn changed.map((c) => ({ json: { ...c.json, noChange: false, total, unchanged } }));"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "변경 있음?",
