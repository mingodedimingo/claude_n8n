{
  "id": "5EiwyEaaYl7GauRq",
  "name": "[WEBHOOK] 카카오톡 톡캘린더 할 일 등록 + 보고",
  "active": true,
  "activeVersionId": "4c97d4b6-dffd-484e-9861-c5db1f36b6e7",
  "createdAt": "2026-11-09T11:18:48.627Z",
  "updatedAt": "2026-11-09T11:18:48.627Z",
  "isArchived": false,
  "versionId": "4c97d4b6-dffd-484e-9861-c5db1f36b6e7",
  "triggerCount": 1,
  "nodes": [
    {
      "id": "b2f0c001-0000-4000-8000-000000000001",
      "name": "웹훅 수신",
      "webhookId": "7c2e4d1a-3b5f-4a8e-9d21-kakaotask0001",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "kakao-task",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "b2f0c001-0000-4000-8000-000000000002",
      "name": "입력 파싱",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst content = String(b.content || '').trim();\nif (!content) throw new Error('content(할 일 내용)가 필요합니다');\nlet raw = String(b.date || '').trim();\nconst now = new Date(Date.now() + 9*3600*1000);\nlet y = now.getUTCFullYear(), m, d;\nlet mm = raw.match(/^([0-9]{4})[-./]?([0-9]{1,2})[-./]?([0-9]{1,2})$/);\nlet km = raw.match(/(?:([0-9]{4})년[ ]*)?([0-9]{1,2})월[ ]*([0-9]{1,2})일/);\nif (mm) { y = +mm[1]; m = +mm[2]; d = +mm[3]; }\nelse if (km) { if (km[1]) y = +km[1]; m = +km[2]; d = +km[3]; }\nelse throw new Error('date 형식 오류: ' + raw);\nconst due_date = `${y}${String(m).padStart(2,'0')}${String(d).padStart(2,'0')}`;\nconst due_info = { due_date, time_zone: 'Asia/Seoul' };\nif (b.alarm_time) due_info.alarm_time = String(b.alarm_time);\nreturn [{ json: { content, due_date, label: `${y}년 ${m}월 ${d}일`, task: { content, due_info } } }];"
      }
    },
    {
      "id": "b2f0c001-0000-4000-8000-000000000003",
      "name": "톡캘린더 할 일 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://kapi.kakao.com/v1/api/calendar/create/task",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "={{ JSON.stringify($json.task) }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "5Y3lZHgroprt9UYW",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "id": "b2f0c001-0000-4000-8000-000000000004",
      "name": "결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst p = $('입력 파싱').first().json;\nconst ok = r.statusCode === 200 && r.body && r.body.task_id;\nconst text = ok\n  ? `✅ 할 일 등록 완료\n📅 ${p.label}\n📝 ${p.content}`\n  : `❌ 할 일 등록 실패 (${r.statusCode})\n📅 ${p.label}\n📝 ${p.content}\n${JSON.stringify(r.body).slice(0,80)}`;\nreturn [{ json: { ok: !!ok, task_id: ok ? r.body.task_id : null, kakao: r.body, report: text.slice(0,200) } }];"
      }
    },
    {
      "id": "b2f0c001-0000-4000-8000-000000000005",
      "name": "카톡 보고 발송",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://kapi.kakao.com/v2/api/talk/memo/default/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "template_object",
              "value": "={{ JSON.stringify({ object_type: 'text', text: $json.report, link: { web_url: 'https://calendar.kakao.com', mobile_web_url: 'https://calendar.kakao.com' } }) }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "5Y3lZHgroprt9UYW",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "id": "b2f0c001-0000-4000-8000-000000000006",
      "name": "응답 구성",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "ok",
              "value": "={{ $('결과 정리').first().json.ok }}",
              "type": "boolean"
            },
            {
              "id": "r2",
              "name": "task_id",
              "value": "={{ $('결과 정리').first().json.task_id }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "kakao",
              "value": "={{ $('결과 정리').first().json.kakao }}",
              "type": "object"
            },
            {
              "id": "r4",
              "name": "report_sent",
              "value": "={{ $json.result_code === 0 }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    }
  ],
